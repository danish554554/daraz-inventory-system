# Server
PORT=5000
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER/DATABASE?retryWrites=true&w=majority
ADMIN_AUTH_SECRET=replace-with-a-long-random-secret
ADMIN_PASSWORD=replace-with-a-strong-password
TRUST_PROXY=true

# Daraz API (required for live synchronization)
DARAZ_ENABLE_LIVE_API=true
DARAZ_APP_KEY=your-daraz-app-key
DARAZ_APP_SECRET=your-daraz-app-secret
DARAZ_OAUTH_REDIRECT_URI=https://YOUR-RENDER-SERVICE.onrender.com/api/stores/oauth/callback
CLIENT_APP_URL=https://YOUR-FRONTEND-URL/stores

# Background synchronization
ORDER_SYNC_ENABLED=true
ORDER_SYNC_HEARTBEAT_MINUTES=1
ORDER_SYNC_INITIAL_DELAY_SECONDS=10
ORDER_SYNC_HISTORY_DAYS=30
RETURN_SYNC_INTERVAL_MINUTES=30
FAILED_DELIVERY_SYNC_INTERVAL_MINUTES=30
